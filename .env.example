# Adresse publique de l'appli (utilisée dans les liens des SMS et pour vérifier la signature Twilio)
BASE_URL=http://localhost:3000
PORT=3000
DATABASE_FILE=deux-toits.sqlite

# console | twilio | brevo
SMS_PROVIDER=console

# Twilio (réponses OUI/NON par SMS possibles)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Brevo (envoi seulement, réponse par lien)
BREVO_API_KEY=
BREVO_SENDER=DeuxToits

# Rappel de la veille
REMINDER_HOUR=19:00
TZ_FAMILLE=Europe/Paris
