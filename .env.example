# Adresse publique de l'appli (utilisée pour les QR codes et comme « sujet » des notifications)
# Les notifications Web Push exigent https en production (http://localhost suffit en local).
BASE_URL=http://localhost:3000
PORT=3000
DATABASE_FILE=deux-toits.sqlite

# Clés VAPID des notifications. Facultatives : sans elles, une paire est générée au premier
# démarrage et gardée dans la base. À fixer en production si la base peut être recréée
# (sinon tous les appareils abonnés devraient se réabonner).
# Générer une paire : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Rappel de la veille
REMINDER_HOUR=19:00
TZ_FAMILLE=Europe/Paris
